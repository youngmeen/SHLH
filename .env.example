# 공공데이터포털(data.go.kr) 일반 인증키.
# 계정 인증키 하나로 활용신청이 승인된 모든 API를 호출한다.
# 실제 값은 .env.local에만 두고 이 파일에는 넣지 않는다(R45).
DATA_GO_KR_API_KEY=your_data_go_kr_service_key

# Supabase Postgres 접속 문자열.
# 직접 연결(db.<ref>.supabase.co)은 IPv6 전용이므로 IPv4 경로가 있는
# Connection Pooler의 Session mode(5432)를 쓴다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 동기화 성공 시 남기는 로컬 백업 경로. 비우면 backups/jib-alim-export.json
BACKUP_PATH=

# (선택) 카카오 REST API 키. 있으면 지도 좌표 확인이 즉시 처리된다.
# 없으면 OpenStreetMap(Nominatim)으로 동작하며, 처음 보는 주소만 초당 1건씩
# 확인하고 결과는 DB에 영구 캐시된다.
KAKAO_REST_API_KEY=
